{
  "sim_version": 1,
  "case_id": "barrier-two-processes",
  "description": "Both worker processes request the control lease in the same barrier batch. Only p1 wins; p2's acquire is rejected and the single request is scheduled once.",
  "config": {
    "auth_ttl_ms": 1000,
    "lease_ttl_ms": 5000,
    "purge_cooldown_ms": 0,
    "max_purge_attempts": 3,
    "max_auth_attempts": 3,
    "initial_process": "p0",
    "auto_lease": true
  },
  "connections": [
    {
      "connection_id": "c1"
    }
  ],
  "tenants": [
    {
      "tenant": "alpha",
      "peer_identity_version": 1,
      "trust_config_version": 1,
      "purpose_level": "interactive"
    }
  ],
  "batches": [
    {
      "batch_id": "start",
      "at": 0,
      "events": [
        {
          "event_id": "s1",
          "type": "release_lease",
          "process_id": "p0"
        }
      ]
    },
    {
      "batch_id": "barrier",
      "at": 10,
      "events": [
        {
          "event_id": "b1",
          "type": "acquire_lease",
          "process_id": "p1"
        },
        {
          "event_id": "b2",
          "type": "acquire_lease",
          "process_id": "p2"
        },
        {
          "event_id": "b3",
          "type": "submit_request",
          "request_id": "r1",
          "tenant": "alpha",
          "candidates": [
            "c1"
          ]
        }
      ]
    }
  ]
}
