{
  "sim_version": 1,
  "case_id": "barrier-takeover-revoke",
  "description": "p0's control lease expires exactly as alpha is revoked; p1 takes over in the same barrier batch. Beta completes normally, alpha is terminated with one receipt.",
  "config": {
    "auth_ttl_ms": 1000,
    "lease_ttl_ms": 50,
    "purge_cooldown_ms": 0,
    "max_purge_attempts": 3,
    "max_auth_attempts": 3,
    "initial_process": "p0",
    "auto_lease": true
  },
  "connections": [
    {
      "connection_id": "c1"
    },
    {
      "connection_id": "c2"
    }
  ],
  "tenants": [
    {
      "tenant": "alpha",
      "peer_identity_version": 1,
      "trust_config_version": 1,
      "purpose_level": "interactive"
    },
    {
      "tenant": "beta",
      "peer_identity_version": 1,
      "trust_config_version": 1,
      "purpose_level": "interactive"
    }
  ],
  "batches": [
    {
      "batch_id": "warm",
      "at": 0,
      "events": [
        {
          "event_id": "w0",
          "type": "submit_request",
          "request_id": "r-alpha",
          "tenant": "alpha",
          "candidates": [
            "c1"
          ]
        },
        {
          "event_id": "w1",
          "type": "submit_request",
          "request_id": "r-beta",
          "tenant": "beta",
          "candidates": [
            "c2"
          ]
        }
      ]
    },
    {
      "batch_id": "auth",
      "at": 1,
      "events": [
        {
          "event_id": "a1",
          "type": "auth_complete",
          "connection_id": "c1",
          "generation": 1,
          "op_id": "op-auth-c1-1",
          "expected_config_version": 1,
          "lease_generation": 1,
          "outcome": "ok"
        },
        {
          "event_id": "a2",
          "type": "auth_complete",
          "connection_id": "c2",
          "generation": 1,
          "op_id": "op-auth-c2-2",
          "expected_config_version": 1,
          "lease_generation": 1,
          "outcome": "ok"
        }
      ]
    },
    {
      "batch_id": "release-p0",
      "at": 2,
      "events": [
        {
          "event_id": "x1",
          "type": "release_lease",
          "process_id": "p0"
        }
      ]
    },
    {
      "batch_id": "barrier",
      "at": 100,
      "events": [
        {
          "event_id": "b1",
          "type": "acquire_lease",
          "process_id": "p1"
        },
        {
          "event_id": "b2",
          "type": "revoke_peer",
          "tenant": "alpha",
          "reason": "cert withdrawn"
        },
        {
          "event_id": "b3",
          "type": "complete_request",
          "request_id": "r-beta",
          "outcome": "success"
        }
      ]
    }
  ]
}
