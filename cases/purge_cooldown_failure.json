{
  "sim_version": 1,
  "case_id": "purge-fails-then-cools-down",
  "description": "A purge of c1's stale alpha context fails. While cooling down the connection is busy and is not purged again; once the cooldown expires the same waiting request issues a second purge, which succeeds, then authenticates and completes.",
  "config": {
    "auth_ttl_ms": 1000,
    "lease_ttl_ms": 5000,
    "purge_cooldown_ms": 25,
    "max_purge_attempts": 2,
    "max_auth_attempts": 3,
    "initial_process": "p0",
    "auto_lease": true
  },
  "connections": [
    {
      "connection_id": "c1",
      "generation": 1
    }
  ],
  "tenants": [
    {
      "tenant": "alpha",
      "peer_identity_version": 1,
      "trust_config_version": 1,
      "purpose_level": "interactive"
    },
    {
      "tenant": "beta",
      "peer_identity_version": 1,
      "trust_config_version": 1,
      "purpose_level": "interactive"
    }
  ],
  "batches": [
    {
      "batch_id": "b01-warm-alpha",
      "at": 0,
      "events": [
        {
          "event_id": "e01",
          "type": "submit_request",
          "request_id": "r-alpha",
          "tenant": "alpha",
          "candidates": [
            "c1"
          ]
        }
      ]
    },
    {
      "batch_id": "b02-alpha-auth",
      "at": 5,
      "events": [
        {
          "event_id": "e02",
          "type": "auth_complete",
          "connection_id": "c1",
          "generation": 1,
          "op_id": "op-auth-c1-1",
          "expected_config_version": 1,
          "lease_generation": 1,
          "outcome": "ok"
        }
      ]
    },
    {
      "batch_id": "b03-alpha-done",
      "at": 10,
      "events": [
        {
          "event_id": "e03",
          "type": "complete_request",
          "request_id": "r-alpha",
          "outcome": "success"
        }
      ]
    },
    {
      "batch_id": "b04-beta-needs-purge",
      "at": 15,
      "events": [
        {
          "event_id": "e04",
          "type": "submit_request",
          "request_id": "r-beta",
          "tenant": "beta",
          "candidates": [
            "c1"
          ]
        }
      ]
    },
    {
      "batch_id": "b05-purge-fails",
      "at": 20,
      "events": [
        {
          "event_id": "e05",
          "type": "purge_complete",
          "connection_id": "c1",
          "generation": 1,
          "op_id": "op-purge-c1-2",
          "expected_config_version": 1,
          "lease_generation": 1,
          "outcome": "fail",
          "reason": "socket reset"
        }
      ]
    },
    {
      "batch_id": "b06-still-cooling",
      "at": 30,
      "events": [
        {
          "event_id": "e06",
          "type": "tick"
        }
      ]
    },
    {
      "batch_id": "b07-cooldown-expired-retry",
      "at": 50,
      "events": [
        {
          "event_id": "e07",
          "type": "tick"
        }
      ]
    },
    {
      "batch_id": "b08-purge-succeeds",
      "at": 55,
      "events": [
        {
          "event_id": "e08",
          "type": "purge_complete",
          "connection_id": "c1",
          "generation": 1,
          "op_id": "op-purge-c1-3",
          "expected_config_version": 1,
          "lease_generation": 1,
          "outcome": "ok"
        }
      ]
    },
    {
      "batch_id": "b09-beta-auth",
      "at": 60,
      "events": [
        {
          "event_id": "e09",
          "type": "auth_complete",
          "connection_id": "c1",
          "generation": 1,
          "op_id": "op-auth-c1-4",
          "expected_config_version": 1,
          "lease_generation": 1,
          "outcome": "ok"
        }
      ]
    },
    {
      "batch_id": "b10-beta-done",
      "at": 70,
      "events": [
        {
          "event_id": "e10",
          "type": "complete_request",
          "request_id": "r-beta",
          "outcome": "success"
        }
      ]
    }
  ]
}
