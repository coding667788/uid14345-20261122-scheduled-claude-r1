{
  "sim_version": 1,
  "case_id": "smoke-one-connection",
  "config": {
    "auth_ttl_ms": 1000,
    "lease_ttl_ms": 1000,
    "purge_cooldown_ms": 0,
    "max_purge_attempts": 3,
    "max_auth_attempts": 3,
    "initial_process": "p0",
    "auto_lease": true
  },
  "connections": [
    {"connection_id": "c1", "generation": 1}
  ],
  "tenants": [
    {"tenant": "alpha", "peer_identity_version": 1, "trust_config_version": 1, "purpose_level": "interactive"}
  ],
  "batches": [
    {
      "batch_id": "b1",
      "at": 0,
      "events": [
        {"event_id": "e1", "type": "submit_request", "request_id": "r1", "tenant": "alpha", "candidates": ["c1"]}
      ]
    },
    {
      "batch_id": "b2",
      "at": 10,
      "events": [
        {"event_id": "e2", "type": "auth_complete", "connection_id": "c1", "generation": 1, "op_id": "op-auth-c1-1", "expected_config_version": 1, "lease_generation": 1, "outcome": "ok"}
      ]
    },
    {
      "batch_id": "b3",
      "at": 20,
      "events": [
        {"event_id": "e3", "type": "complete_request", "request_id": "r1", "outcome": "success"}
      ]
    }
  ]
}
