{
  "sim_version": 1,
  "case_id": "purpose-level-change-forces-reauth",
  "description": "c1 is warm for alpha/interactive. The tenant's purpose level changes to batch, so the four-part context no longer matches: the connection must be purged and re-authenticated before r2 can use it.",
  "config": {
    "auth_ttl_ms": 1000,
    "lease_ttl_ms": 5000,
    "purge_cooldown_ms": 0,
    "max_purge_attempts": 3,
    "max_auth_attempts": 3,
    "initial_process": "p0",
    "auto_lease": true
  },
  "connections": [
    {"connection_id": "c1", "generation": 1}
  ],
  "tenants": [
    {"tenant": "alpha", "peer_identity_version": 1, "trust_config_version": 1, "purpose_level": "interactive"}
  ],
  "batches": [
    {
      "batch_id": "b01-warm",
      "at": 0,
      "events": [
        {"event_id": "e01", "type": "submit_request", "request_id": "r1", "tenant": "alpha", "candidates": ["c1"]}
      ]
    },
    {
      "batch_id": "b02-auth-r1",
      "at": 10,
      "events": [
        {"event_id": "e02", "type": "auth_complete", "connection_id": "c1", "generation": 1, "op_id": "op-auth-c1-1", "expected_config_version": 1, "lease_generation": 1, "outcome": "ok"}
      ]
    },
    {
      "batch_id": "b03-finish-r1",
      "at": 20,
      "events": [
        {"event_id": "e03", "type": "complete_request", "request_id": "r1", "outcome": "success"}
      ]
    },
    {
      "batch_id": "b04-purpose-level-changes",
      "at": 30,
      "events": [
        {"event_id": "e04", "type": "set_purpose_level", "tenant": "alpha", "purpose_level": "batch"},
        {"event_id": "e05", "type": "submit_request", "request_id": "r2", "tenant": "alpha", "candidates": ["c1"]}
      ]
    },
    {
      "batch_id": "b05-purge-old-context",
      "at": 40,
      "events": [
        {"event_id": "e06", "type": "purge_complete", "connection_id": "c1", "generation": 1, "op_id": "op-purge-c1-2", "expected_config_version": 2, "lease_generation": 1, "outcome": "ok"}
      ]
    },
    {
      "batch_id": "b06-auth-new-purpose",
      "at": 50,
      "events": [
        {"event_id": "e07", "type": "auth_complete", "connection_id": "c1", "generation": 1, "op_id": "op-auth-c1-3", "expected_config_version": 2, "lease_generation": 1, "outcome": "ok"}
      ]
    },
    {
      "batch_id": "b07-finish-r2",
      "at": 60,
      "events": [
        {"event_id": "e08", "type": "complete_request", "request_id": "r2", "outcome": "success"}
      ]
    }
  ]
}
