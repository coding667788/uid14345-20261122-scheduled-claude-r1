{
  "sim_version": 1,
  "case_id": "process-exit-and-resume-duplicate-completion",
  "description": "p0 submits work and starts an auth, then exits. Its in-flight operation becomes PENDING_ACK (not completed). p1 takes over, resends the operation idempotently, and the same completion is delivered twice. The request must see exactly one success receipt.",
  "config": {
    "auth_ttl_ms": 1000,
    "lease_ttl_ms": 50,
    "purge_cooldown_ms": 0,
    "max_purge_attempts": 3,
    "max_auth_attempts": 3,
    "initial_process": "p0",
    "auto_lease": true
  },
  "connections": [
    {"connection_id": "c1", "generation": 1}
  ],
  "tenants": [
    {"tenant": "alpha", "peer_identity_version": 1, "trust_config_version": 1, "purpose_level": "interactive"}
  ],
  "batches": [
    {
      "batch_id": "b01-submit",
      "at": 0,
      "events": [
        {"event_id": "e01", "type": "submit_request", "request_id": "r1", "tenant": "alpha", "candidates": ["c1"]}
      ]
    },
    {
      "batch_id": "b02-p0-exits",
      "at": 10,
      "events": [
        {"event_id": "e02", "type": "worker_exit", "process_id": "p0", "reason": "OOM"}
      ]
    },
    {
      "batch_id": "b03-p1-takes-over-and-resends",
      "at": 100,
      "events": [
        {"event_id": "e03", "type": "acquire_lease", "process_id": "p1"},
        {"event_id": "e04", "type": "retry_op", "op_id": "op-auth-c1-1"}
      ]
    },
    {
      "batch_id": "b04-auth-completes",
      "at": 110,
      "events": [
        {"event_id": "e05", "type": "auth_complete", "connection_id": "c1", "generation": 1, "op_id": "op-auth-c1-1", "expected_config_version": 1, "lease_generation": 2, "outcome": "ok"}
      ]
    },
    {
      "batch_id": "b05-duplicate-completion-after-restart",
      "at": 120,
      "events": [
        {"event_id": "e06", "type": "auth_complete", "connection_id": "c1", "generation": 1, "op_id": "op-auth-c1-1", "expected_config_version": 1, "lease_generation": 2, "outcome": "ok"}
      ]
    },
    {
      "batch_id": "b06-complete",
      "at": 130,
      "events": [
        {"event_id": "e07", "type": "complete_request", "request_id": "r1", "outcome": "success"}
      ]
    },
    {
      "batch_id": "b07-duplicate-complete-after-restart",
      "at": 140,
      "events": [
        {"event_id": "e08", "type": "complete_request", "request_id": "r1", "outcome": "success"}
      ]
    }
  ]
}
